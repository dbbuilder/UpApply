# UpApply API Environment Variables

# Database - PostgreSQL with pgvector extension
# For local development, use a local PostgreSQL instance
# For Render, this is automatically set from the database connection string
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/upapply

# OpenAI API Key - Required for embeddings and cover letter generation
OPENAI_API_KEY=sk-your-openai-api-key-here

# JWT Secret Key - Used for signing authentication tokens
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# CORS Origins - Allowed origins for API requests
# JSON array format for Chrome extension and Upwork
CORS_ORIGINS=["chrome-extension://*", "https://www.upwork.com", "http://localhost:5173"]

# AI Model Configuration
DEFAULT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Token Expiration (in minutes) - Default 7 days
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Debug mode - Set to false in production
DEBUG=true
