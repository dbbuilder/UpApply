{
  "manifest_version": 3,
  "name": "UpApply - AI Cover Letters for Upwork",
  "version": "1.0.0",
  "description": "Generate personalized cover letters for Upwork jobs using AI and your experience memories",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.upwork.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/jobs/*", "https://www.upwork.com/nx/proposals/*"],
      "js": ["src/content/index.ts"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_title": "UpApply",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
